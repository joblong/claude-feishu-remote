# Claude Code × 飞书远程审批 — 环境变量
# 复制本文件为 .env 并填入真实值。install.sh 会把 .env 装到 ~/.claude/feishu-remote/.env

# 飞书自建应用 App ID / Secret(open.feishu.cn → 开发者后台 → 你的应用 → 凭证与基础信息)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 审批卡片推送目标用户的 open_id。
# 留空即可:daemon 启动后,在飞书 1:1 对话里给机器人发任意一句话,
# daemon 会自动把发送者记为审批者并回写本文件。
# 群消息会被忽略(TOFU 防误绑)。换人用 `afk unbind` 清空后重启。
FEISHU_TARGET_OPEN_ID=

# 可选:日志级别 DEBUG|INFO|WARN|ERROR(默认 INFO)
# FEISHU_LOG_LEVEL=INFO
